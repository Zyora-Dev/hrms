DATABASE_URL=postgresql+psycopg://user@localhost:5432/z_hrms
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=15
TIMEZONE=Asia/Kolkata

# Where uploads and database dumps are kept. Leave blank locally and they sit
# under backend/; hosted installs point it at a mounted disk, e.g. /var/data.
DATA_DIR=

# --- Outgoing mail (Zoho CPaaS) -------------------------------------------
ZOHO_CPAAS_URL=https://cpaas.zoho.in/v1.1/email
ZOHO_CPAAS_KEY=
MAIL_FROM_ADDRESS=hr@yourcompany.com
MAIL_FROM_NAME=HRMS
MAIL_REPLY_TO=

# Encrypts Aadhaar at rest. Keep it separate from JWT_SECRET, so rotating
# one does not make the other's data unreadable. Generate with:
#   python -m scripts.set_encryption_key
DATA_ENCRYPTION_KEY=
